      <column caption='Source / Event' datatype='string' name='[Calculation_1191193594212352]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([eq_name], [source])' />
      </column>
      <column caption='DEM Scarp_Height' datatype='real' name='[Calculation_1191193594449921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([source] = &apos;DEM&apos;, [scarp_height], NULL)' />
      </column>
      <column caption='Overlay Scarp_Height' datatype='real' name='[Calculation_1191193594585090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([source] &lt;&gt; &apos;DEM&apos;, [scarp_height], NULL)' />
      </column>
      <column caption='Color' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1191193594687491]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Fault_Dip&apos;   THEN STR([fault_dip])&#10;    WHEN &apos;Scarp_Class&apos; THEN [scarp_class]&#10;    ELSE [Calculation_1191193594212352]&#10;  END' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column datatype='integer' name='[fault_dip]' role='dimension' type='ordinal' />
      <column datatype='string' name='[source]' role='dimension' type='nominal' />
