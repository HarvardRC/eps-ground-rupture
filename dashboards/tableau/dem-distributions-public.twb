      <column caption='Measure Value' datatype='real' name='[Calculation_2326601193566213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2326601191555072]&#10;    WHEN &quot;Scarp Height&quot; THEN [Scarp_Height]&#10;    WHEN &quot;Us - Ud&quot;      THEN [Us - Ud]&#10;    WHEN &quot;DZW&quot;          THEN [DZW]&#10;    WHEN &quot;Scarp Dip&quot;    THEN [Scarp_Dip]&#10;END' />
