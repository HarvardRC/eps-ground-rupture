      <column caption='Fig8 Mean' datatype='real' name='[Calculation_0708542655561728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2326601191555072]&#10;  WHEN &quot;Scarp Height&quot; THEN [mean_scarp_height]&#10;  WHEN &quot;Us - Ud&quot;      THEN [mean_us_ud]&#10;  WHEN &quot;DZW&quot;          THEN [mean_dzw]&#10;  WHEN &quot;Scarp Dip&quot;    THEN [mean_scarp_dip]&#10;END' />
