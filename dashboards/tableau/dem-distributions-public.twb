      <column caption='Fig8 Mean' datatype='real' name='[Calculation_0708542655561728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2326601191555072]&#10;  WHEN &quot;Scarp Height&quot; THEN [mean_scarp_height]&#10;  WHEN &quot;Us - Ud&quot;      THEN [mean_us_ud]&#10;  WHEN &quot;DZW&quot;          THEN [mean_dzw]&#10;  WHEN &quot;Scarp Dip&quot;    THEN [mean_scarp_dip]&#10;END' />
      </column>
      <column caption='Fig8 SD' datatype='real' name='[Calculation_0708542655881217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2326601191555072]&#10;  WHEN &quot;Scarp Height&quot; THEN [sd_scarp_height]&#10;  WHEN &quot;Us - Ud&quot;      THEN [sd_us_ud]&#10;  WHEN &quot;DZW&quot;          THEN [sd_dzw]&#10;  WHEN &quot;Scarp Dip&quot;    THEN [sd_scarp_dip]&#10;END' />
      </column>
      <column caption='Fig8 Lo' datatype='real' name='[Calculation_0708542656212994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0708542655561728] - [Calculation_0708542655881217]' />
      </column>
      <column caption='Fig8 Hi' datatype='real' name='[Calculation_0708542656319491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0708542655561728] + [Calculation_0708542655881217]' />
      </column>
      <column caption='Fig8 Class Group' datatype='string' name='[Calculation_4752547225280513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [scarp_class]&#10;  WHEN &quot;Monoclinal&quot;              THEN &quot;Plain classes&quot;&#10;  WHEN &quot;Pressure Ridge&quot;          THEN &quot;Plain classes&quot;&#10;  WHEN &quot;Simple&quot;                  THEN &quot;Plain classes&quot;&#10;  WHEN &quot;Monoclinal Collapse&quot;     THEN &quot;Collapse classes&quot;&#10;  WHEN &quot;Pressure Ridge Collapse&quot; THEN &quot;Collapse classes&quot;&#10;  WHEN &quot;Simple Collapse&quot;         THEN &quot;Collapse classes&quot;&#10;END' />
      </column>
