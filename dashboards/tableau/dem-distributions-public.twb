              <calculation class='tableau' formula='[Table Name] = &quot;dem.csv&quot;' />
            </column>
            <column caption='Measure Value' datatype='real' name='[Calculation_2326601193566213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2326601191555072] &#10;    WHEN &quot;Scarp Height&quot; THEN [Scarp_Height] &#10;    WHEN &quot;DZW&quot; THEN [DZW] &#10;    WHEN &quot;Scarp Dip&quot; THEN [Scarp_Dip] &#10;END' />
            </column>
            <column caption='Hue Value' datatype='string' name='[Calculation_2326601193844742]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2326601191817217] &#10;    WHEN &quot;Scarp Class&quot; THEN [Scarp_Class] &#10;    WHEN &quot;Density&quot; THEN STR([Density]) &#10;    WHEN &quot;Depth&quot; THEN STR([Depth]) &#10;    WHEN &quot;Fault Dip&quot; THEN STR([Fault_Dip]) &#10;    WHEN &quot;Sediment Strength&quot; THEN STR([Sediment_Strength]) &#10;    WHEN &quot;FS Depth&quot; THEN STR([FS_depth]) &#10;    ELSE STR([UnrupturedSed]) &#10;END' />
            </column>
            <column caption='Is Final State' datatype='boolean' name='[Calculation_2326601194184711]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [Trial] : MAX([Slip]) } = [Slip]' />
            </column>
            <column caption='Keep Row' datatype='boolean' name='[Calculation_2326601194352648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_2326601193439236] &#10;OR [Parameters].[Parameter 2326601192820739] = &quot;All steps&quot; &#10;OR [Calculation_2326601194184711]' />
            </column>
            <column caption='Bin Width' datatype='real' name='[Calculation_2326601194524681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2326601191555072]&#10;  WHEN &quot;Scarp Height&quot; THEN 0.25&#10;  WHEN &quot;DZW&quot;          THEN 1.0&#10;  WHEN &quot;Scarp Dip&quot;    THEN 5.0&#10;END' />
            </column>
            <column caption='Bin' datatype='real' name='[Calculation_2326601194631178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOOR([Calculation_2326601193566213] / [Calculation_2326601194524681]) * [Calculation_2326601194524681]' />
            </column>
            <column caption='Count DEM' datatype='integer' name='[Calculation_2326601194729483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_2326601193439236] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Event Label' datatype='string' name='[Calculation_2326601194950669]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[eq_name] + &quot; (M &quot; + STR([magnitude]) + &quot;)&quot;' />
            </column>
            <column caption='Needle' datatype='integer' name='[Calculation_2326601207484432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(IF NOT [Calculation_2326601193439236] THEN [Calculation_2326601210114066] END)' />
            </column>
            <column caption='Needle Peak' datatype='integer' name='[Calculation_2326601210114066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ &#10;    FIXED : MAX({ &#10;        FIXED [Calculation_2326601194631178] : SUM(&#10;            IF [Calculation_2326601193439236] AND NOT ISNULL([Calculation_2326601193566213]) &#10;                THEN 1 &#10;            END) &#10;        }) &#10;}' />
            </column>
