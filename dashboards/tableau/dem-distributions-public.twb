      <column caption='Fig8 SD' datatype='real' name='[Calculation_0708542655881217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2326601191555072]&#10;  WHEN &quot;Scarp Height&quot; THEN [sd_scarp_height]&#10;  WHEN &quot;Us - Ud&quot;      THEN [sd_us_ud]&#10;  WHEN &quot;DZW&quot;          THEN [sd_dzw]&#10;  WHEN &quot;Scarp Dip&quot;    THEN [sd_scarp_dip]&#10;END' />
