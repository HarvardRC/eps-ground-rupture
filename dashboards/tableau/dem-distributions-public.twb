          <datasource-dependencies datasource='Parameters'>
            <column caption='Measure' datatype='string' name='[Parameter 2326601191555072]' param-domain-type='list' role='measure' type='nominal' value='&quot;Scarp Height&quot;'>
              <calculation class='tableau' formula='&quot;Scarp Height&quot;' />
            </column>
