  <worksheets>
    <worksheet name='Response Curves'>
      <table>
        <view>
          <datasources>
            <datasource caption='GroundRaptureDEM-CSV' name='federated.1or8g8o1xpy8wd1a368cu1icvhuo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Driver' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Slip&quot;'>
              <calculation class='tableau' formula='&quot;Slip&quot;' />
            </column>
            <column alias='Scarp Height' caption='Response' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Scarp_Height&quot;'>
              <calculation class='tableau' formula='&quot;Scarp_Height&quot;' />
              <aliases>
                <alias key='&quot;Scarp_Dip&quot;' value='Scarp Dip' />
                <alias key='&quot;Scarp_Height&quot;' value='Scarp Height' />
              </aliases>
            </column>
            <column alias='Scarp Class' caption='Condition By' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Scarp_Class&quot;'>
              <calculation class='tableau' formula='&quot;Scarp_Class&quot;' />
              <aliases>
                <alias key='&quot;Fault_Dip&quot;' value='Fault Dip' />
                <alias key='&quot;Scarp_Class&quot;' value='Scarp Class' />
                <alias key='&quot;Sediment_Strength&quot;' value='Sediment Strength' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1or8g8o1xpy8wd1a368cu1icvhuo'>
            <column caption='Magnitude' datatype='real' name='[Calculation_5561481032470528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='6.94 + 1.14*LOG([Slip])' />
            </column>
            <column caption='Driver Value' datatype='real' name='[Calculation_5561481033752577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;Slip&apos;      THEN [Slip]&#10;  WHEN &apos;Magnitude&apos; THEN [Calculation_5561481032470528]&#10;END' />
            </column>
            <column caption='Response Value' datatype='real' name='[Calculation_5561481033887746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Scarp_Height&apos; THEN [Scarp_Height]&#10;  WHEN &apos;DZW&apos;          THEN [DZW]&#10;  WHEN &apos;Scarp_Dip&apos;    THEN [Scarp_Dip]&#10;  WHEN &apos;Us - Ud&apos;      THEN [Us - Ud]&#10;END' />
            </column>
            <column caption='Condition' datatype='string' name='[Calculation_5561481034330115]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Scarp_Class&apos;       THEN [Scarp_Class]&#10;  WHEN &apos;Fault_Dip&apos;         THEN STR([Fault_Dip])&#10;  WHEN &apos;Cohesion&apos;          THEN [Cohesion]&#10;  WHEN &apos;Set&apos;               THEN [Set]&#10;  WHEN &apos;Density&apos;           THEN STR([Density])&#10;  WHEN &apos;Sediment_Strength&apos; THEN STR([Sediment_Strength])&#10;END' />
            </column>
            <column datatype='string' name='[Cohesion]' role='dimension' type='nominal' />
            <column datatype='real' name='[DZW]' role='measure' type='quantitative' />
            <column datatype='string' name='[Density]' role='dimension' type='nominal' />
            <column caption='Fault Dip' datatype='integer' name='[Fault_Dip]' role='measure' type='quantitative' />
            <column caption='Scarp Class' datatype='string' name='[Scarp_Class]' role='dimension' type='nominal' />
            <column caption='Scarp Dip' datatype='real' name='[Scarp_Dip]' role='measure' type='quantitative' />
            <column caption='Scarp Height' datatype='real' name='[Scarp_Height]' role='measure' type='quantitative' />
            <column caption='Sediment Strength' datatype='string' name='[Sediment_Strength]' role='dimension' type='nominal' />
            <column datatype='string' name='[Set]' role='dimension' type='nominal' />
            <column datatype='real' name='[Slip]' role='measure' type='quantitative' />
            <column datatype='real' name='[Us - Ud]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5561481034330115]' derivation='None' name='[none:Calculation_5561481034330115:nk]' pivot='key' type='nominal' />
