      <column caption='Magnitude' datatype='real' name='[Calculation_5561481032470528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='6.94 + 1.14*LOG([Slip])' />
      </column>
      <column caption='Driver Value' datatype='real' name='[Calculation_5561481033752577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;Slip&apos;      THEN [Slip]&#10;  WHEN &apos;Magnitude&apos; THEN [Calculation_5561481032470528]&#10;END' />
      </column>
      <column caption='Response Value' datatype='real' name='[Calculation_5561481033887746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Scarp_Height&apos; THEN [Scarp_Height]&#10;  WHEN &apos;DZW&apos;          THEN [DZW]&#10;  WHEN &apos;Scarp_Dip&apos;    THEN [Scarp_Dip]&#10;  WHEN &apos;Us - Ud&apos;      THEN [Us - Ud]&#10;END' />
