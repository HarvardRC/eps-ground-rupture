            <column caption='Magnitude' datatype='real' name='[Calculation_5561481032470528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='6.94 + 1.14*LOG([slip])' />
            </column>
            <column caption='Driver Value' datatype='real' name='[Calculation_5561481033752577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;Slip&apos;      THEN [slip]&#10;  WHEN &apos;Magnitude&apos; THEN [Calculation_5561481032470528]&#10;END' />
            </column>
            <column caption='Response Value' datatype='real' name='[Calculation_5561481033887746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Scarp_Height&apos; THEN [scarp_height]&#10;  WHEN &apos;DZW&apos;          THEN [dzw]&#10;  WHEN &apos;Scarp_Dip&apos;    THEN [scarp_dip]&#10;  WHEN &apos;Us - Ud&apos;      THEN [us_ud]&#10;END' />
            </column>
            <column caption='Condition' datatype='string' name='[Calculation_5561481034330115]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;Scarp_Class&apos;       THEN [scarp_class]&#10;  WHEN &apos;Fault_Dip&apos;         THEN STR([fault_dip])&#10;  WHEN &apos;Cohesion&apos;          THEN [cohesion]&#10;  WHEN &apos;Set&apos;               THEN [set]&#10;  WHEN &apos;Density&apos;           THEN STR([density])&#10;  WHEN &apos;Sediment_Strength&apos; THEN STR([sediment_strength])&#10;END' />
            </column>
