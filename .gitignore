# PyCharm
#   JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#   be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#   and can be added to the global gitignore or merged into this file.  For a more nuclear
#   option (not recommended) you can uncomment the following to ignore the entire idea folder.
# .idea/

# Abstra
#   Abstra is an AI-powered process automation framework.
#   Ignore directories containing user credentials, local state, and settings.
#   Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#   Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#   that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#   and can be added to the global gitignore or merged into this file. However, if you prefer, 
#   you could uncomment the following to ignore the entire vscode folder
# .vscode/
# Temporary file for partial code execution
tempCodeRunnerFile.py

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml

# Project data — large, regenerable, or sensitive. Keep .gitkeep markers tracked.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Tableau temp / backup files
*.twb.bak
*.twbr
Tableau Generated Files/

# Generated DDL (regenerated by `poetry run egr-build`; spark-thrift.sql is machine-specific)
dashboards/sql/*.sql
!dashboards/sql/.gitkeep

# Generated DuckDB views file (regenerated by `poetry run egr-build`)
dashboards/duckdb/*.duckdb
dashboards/duckdb/*.duckdb.wal
!dashboards/duckdb/.gitkeep

# macOS
.DS_Store

# JetBrains IDE — per-user config, not for VCS
.idea/
# .iml is generated by Gradle's `idea` task or by IDEA's Gradle import;
# never commit (the source of truth is `idea { ... }` in build.gradle.kts).
*.iml

# Claude Code project state
.claude/

/legacy/
/ai/

# Gradle local cache (per-machine; build outputs use the existing `build/` rule)
.gradle/

# Terraform — local state and provider caches stay out of VCS.
# (.terraform.lock.hcl and deploy/terraform/tables.json ARE committed.)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Google service-account / OAuth keys — NEVER commit. egr-push-sheets reads
# the key by PATH (GOOGLE_SHEETS_SA_KEYFILE, default resources/local/
# eps-sheets-sa.json); the key file stays under the gitignored resources/local/
# below. These name globs are a backstop in case a key is dropped elsewhere.
# (.env.example IS committed; the `.env` rule above only matches `.env`.)
*service-account*.json
*service_account*.json
*-sa.json
sa.json
# Google's default SA-key download name (service-account email + .json):
*.iam.gserviceaccount.com.json
gcp-*.json
credentials.json
client_secret*.json
/resources/local/*
