# Example environment variables for eps-ground-rapture.
# Copy to `.env` and fill in real values. `.env` is gitignored.
# These vars are read from the process environment; `egr-push-sheets` does
# not auto-load `.env`, so export it yourself:
#   set -a; source .env; set +a

# PATH to the Google service-account key file (NOT the key contents — only a
# path, never a secret, so this line is safe to commit). Used by
# `egr-push-sheets` to write DuckDB views to Google Sheets for Tableau Public.
# Unset -> defaults to resources/local/eps-sheets-sa.json (gitignored) under
# the repo root. Create the key in the GCP console:
#   IAM & Admin -> Service Accounts -> Keys -> Add Key -> JSON,
# then save it to that default path or point this variable at it.
# See dashboards/sheets/README.md for the full one-time setup.
GOOGLE_SHEETS_SA_KEYFILE=resources/local/eps-sheets-sa.json
